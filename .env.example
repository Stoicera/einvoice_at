# Local development environment for docker-compose.
# Copy to .env and adjust. Never commit .env.

# Port the app is published on (container always listens on 8080).
APP_PORT=8080

# PostgreSQL (used by the app from milestone M3 on; the service is already part
# of the compose stack so the local environment is stable from day one).
POSTGRES_DB=einvoice
POSTGRES_USER=einvoice
# Required — no default. Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Keycloak (identity provider, joins the stack at M3). Dev mode, realm auto-imported
# from keycloak/dev-realm.json. These bootstrap the Keycloak admin account and are
# required — no default (like POSTGRES_PASSWORD). They are the master-admin login for
# the local Keycloak only; the app itself authenticates via the imported realm, not these.
KEYCLOAK_ADMIN=
# Required — no default. Generate one:  openssl rand -base64 24
KEYCLOAK_ADMIN_PASSWORD=
# Host port Keycloak is published on (container listens on 8080). The app derives its
# OAUTH2_ISSUER_URI (http://localhost:<this>/realms/einvoice) from it in docker-compose.yml.
KEYCLOAK_PORT=8081

# Where the app validates access tokens against. docker-compose.yml sets both explicitly for the
# local stack (the browser-facing issuer, and the container-network JWKS URL — they differ on
# purpose, see the comments there), so they are NOT normally set in .env. They are documented here
# because a deployment OUTSIDE compose — Dokploy at M6, or `./mvnw spring-boot:run` against a real
# Keycloak — has to supply them, and an undocumented required variable is the same class of silent
# failure as an undocumented one that compose never passes through (M5 hostile review, F7).
# Leave both blank to run with no resource-server issuer check at all (the state every persistence
# integration test runs in).
OAUTH2_ISSUER_URI=
# Derived from OAUTH2_ISSUER_URI when blank (Keycloak's standard /protocol/openid-connect/certs).
# Set it only for a non-Keycloak JWKS layout, or when the issuer a token claims and the URL this
# app can reach are different hosts — which is exactly the compose case.
OAUTH2_JWK_SET_URI=

# Database host as the APP resolves it. LEAVE BLANK for the compose stack — blank means compose's
# own default, the service name `postgres`, and setting it to `localhost` here would point the
# container at itself. It exists as a variable for a deployment that runs the app outside compose
# against a managed database.
POSTGRES_HOST=

# Optional: require every access token's `aud` claim to contain this value (typically the API's
# Keycloak client id). Signature and issuer prove a token is genuine, not that it was minted FOR
# this API — set this on any shared or production realm. Left blank for the local dev realm,
# whose tokens carry Keycloak's default `account` audience. See docs/adr/0006.
OAUTH2_AUDIENCE=

# OpenAPI document (/v3/api-docs) and Swagger UI (/swagger-ui.html). Served anonymously, which is
# right for a local or portfolio instance. Set to false on any deployment that should not publish
# its full API description to anonymous callers.
API_DOCS_ENABLED=true

# Cap on any single request body — multipart uploads and plain bodies alike; both answer 413.
# Nothing in Boot or Tomcat bounds an ordinary body on its own, so an application-layer filter
# enforces this one.
MAX_REQUEST_BODY_SIZE=2MB

# Cap on the number of ACTIVE (non-revoked) API keys one tenant may hold. Revoked keys keep their
# rows for the audit trail and do not count, so a tenant at the cap makes room by revoking rather
# than by losing history.
API_KEYS_MAX_ACTIVE_PER_TENANT=25

# Rate limits (token bucket; capacity = burst, refill = sustained rate per minute).
#
# POST /api/v1/validate — per client IP, ANONYMOUS callers only. The limit protects an open,
# unauthenticated endpoint; a caller who has authenticated is not the threat it exists for.
RATE_LIMIT_VALIDATE_CAPACITY=10
RATE_LIMIT_VALIDATE_REFILL_PER_MINUTE=10
#
# POST /api/v1/convert — per CREDENTIAL (tenant id for an API key, token subject for a JWT), and
# applied to authenticated callers too, since that endpoint admits no others. A conversion is the
# most expensive thing this platform does: a read, two mappings, a write, and a full Peppol XSLT
# validation of the result. Added by the M4 hostile review, which found it entirely unlimited.
RATE_LIMIT_CONVERT_CAPACITY=20
RATE_LIMIT_CONVERT_REFILL_PER_MINUTE=20
#
# POST /api/v1/reports/{id}/explain and the dashboard's per-finding "Erklären" — per CREDENTIAL and
# applied to authenticated callers too, for the same reason as convert. THIS IS THE ONE LIMIT HERE
# WHOSE UNIT IS EUROS: every request past the explanation cache is a paid third-party call. Both
# routes share this bucket (they buy the same thing), and it is separate from the validate bucket so
# that running out of explanations never stops a tenant validating. Added by the M5 hostile review,
# which found both routes unlimited — app.ai.max-findings-per-request bounds one request, not a rate.
# The public /validator/erklaeren is not covered here: it shares the anonymous validate bucket.
RATE_LIMIT_EXPLAIN_CAPACITY=30
RATE_LIMIT_EXPLAIN_REFILL_PER_MINUTE=30

# Mailpit (local SMTP sink, joins the stack at M3; consumed by the app from M5).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Web UI (M5)
# ---------------------------------------------------------------------------

# Browser login (OAuth2 authorization-code flow against Keycloak). Set by
# docker-compose from the dev realm's `einvoice-web` client; these are dev-only values shipped in
# keycloak/dev-realm.json, never production ones. Leave the client id BLANK to run without a login:
# the public validator still works and /app/** is simply refused (SecurityConfig applies oauth2Login
# only when a client registration exists), which is also what every integration test does.
OAUTH2_CLIENT_ID=einvoice-web
OAUTH2_CLIENT_SECRET=dev-einvoice-web-secret-not-for-production

# ---------------------------------------------------------------------------
# KI-Erklärungen (M5) — off by default
# ---------------------------------------------------------------------------

# The feature flag SPEC §2 names. OFF by default and deliberately so: the feature costs money per
# click and sends text to a third-party provider, which is something an operator switches on
# knowingly. With it off the platform is complete — validator, reports and API unchanged, and the
# "Erklären" buttons are simply not rendered.
#
# With it ON, AI_API_KEY becomes REQUIRED: the application refuses to start without one rather than
# booting a provider client that cannot possibly work.
FEATURES_AI_EXPLANATIONS=false

# OpenRouter (or any OpenAI-compatible endpoint — a LiteLLM gateway or a self-hosted proxy works by
# pointing AI_BASE_URL at it, which is the substitutability ENGINEERING_STANDARDS §8 asks for).
# Get a key at https://openrouter.ai/keys
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1

# The provider's model slug.
#
# Sonnet is the shipped default for the PUBLIC validator: explaining a published Schematron rule in two
# short German paragraphs is translation and framing, not open-ended reasoning — the task class where
# the gap to a larger model is smallest — and the page is free to the public, so cost per distinct
# finding is a real constraint. (Per click it is not: the cache serves repeat findings without a call.)
#
# RUNNING THIS FOR PAYING TENANTS, with explanation quality as a product feature? Set
#   AI_MODEL=anthropic/claude-opus-5
# There the economics invert: the cost sits against a contract rather than against a lead magnet.
# See docs/adr/0010-ai-assist.md.
AI_MODEL=anthropic/claude-sonnet-5

# Per-attempt timeout, retries AFTER the first attempt (only transient failures — 429, 5xx, IO — are
# retried; a 4xx never is), and the ceiling on one explanation's length.
AI_TIMEOUT=15s
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=700

# How many findings ONE POST /api/v1/reports/{id}/explain (or one "alle erklären" in the dashboard)
# may explain, most severe first. This is the bound on what a single request can cost: a Peppol report
# can carry dozens of findings, each distinct one is a paid call, and "explain everything" without a
# ceiling turns one POST into an unbounded bill. Findings past the cap come back with a null
# explanation — the same thing that field means everywhere else. Pass ?findingIndex=N to explain
# exactly one instead.
AI_MAX_FINDINGS_PER_REQUEST=10

# ---------------------------------------------------------------------------------------------
# Aufbewahrung / retention (GDPR Art. 5(1)(e), storage limitation)
# ---------------------------------------------------------------------------------------------
# A nightly job deletes data past these windows. ZERO OR NEGATIVE MEANS KEEP FOREVER — that is the
# off switch, and there is deliberately no separate `enabled` flag that could disagree with it.
#
# INVOICES ARE NOT IN THIS LIST AND NEVER WILL BE. § 132 BAO obliges an Austrian business to keep
# its invoices for seven years; a platform that swept them up after a year would be destroying
# records its users are legally required to hold. Invoices are deleted only when a tenant asks, via
# DELETE /api/v1/tenant or the dashboard's danger zone — a different operation with different rules.
RETENTION_REPORT_DAYS=365
RETENTION_AUDIT_DAYS=730
# Spring cron (6 fields: second minute hour day month weekday). Daily at 03:15 server time.
RETENTION_CRON=0 15 3 * * *

# ---------------------------------------------------------------------------------------------
# Betrieb / operations (M6)
# ---------------------------------------------------------------------------------------------
# WHO IS THE CLIENT, behind a reverse proxy. This is a security setting in BOTH directions, which is
# why it is a knob and not a constant:
#
#   none       (default) X-Forwarded-For is ignored. Correct when nothing sits in front of the app:
#              the header is caller-supplied text, so honouring it would let anyone mint themselves
#              an unlimited number of rate-limit buckets on the anonymous validator.
#   framework  Spring's ForwardedHeaderFilter rewrites each request from X-Forwarded-For/-Proto/
#              -Host. Correct ONLY behind a trusted proxy (Traefik via Dokploy — see
#              docs/deployment.md). Without it every anonymous caller shares the proxy's address, so
#              the per-IP limit becomes one global bucket and one abusive client throttles everybody.
#
# There is no value that is right in both topologies, so the deployment states which one it is.
SERVER_FORWARD_HEADERS_STRATEGY=none

# OpenTelemetry (ADR-0012). OFF by default, and that default is load-bearing: Boot's own defaults for
# both exporters are "enabled, pointing at localhost:4318", so leaving them alone would have every
# installation that never asked for observability posting spans and metrics into a socket nobody is
# listening on.
#
# The local stack:
#     OTEL_ENABLED=true docker compose --profile observability up -d
#
# THE PROFILE DOES NOT SET THIS BY ITSELF. A compose profile decides which SERVICES start; it cannot
# set an environment variable on a service. Either put OTEL_ENABLED=true here or give it on the
# command line as above.
OTEL_ENABLED=false
# Trace sampling ratio, 0.0–1.0. 1.0 locally because a portfolio stack has no traffic to sample away
# and a half-sampled demo trace is a confusing demo. A real deployment lowers it; Boot's own default
# is 0.1.
OTEL_SAMPLING_PROBABILITY=1.0
# OTLP endpoints. These defaults resolve only inside the compose network; a deployment points them at
# its own collector, Grafana Cloud, or a managed Tempo/Prometheus.
OTEL_TRACES_ENDPOINT=http://tempo:4318/v1/traces
OTEL_METRICS_ENDPOINT=http://prometheus:9090/api/v1/otlp/v1/metrics
# How often metrics are pushed. 15s matches the dashboard's expectations; longer is cheaper.
OTEL_METRICS_STEP=15s

# Host ports for the observability profile's three containers. All bound to 127.0.0.1 — none of them
# authenticates anything, and Grafana runs with anonymous admin access on purpose (it holds nothing
# but this stack's own numbers). docs/deployment.md deliberately does NOT deploy them.
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
GRAFANA_PORT=3000
