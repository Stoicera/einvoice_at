# Local development environment for docker-compose.
# Copy to .env and adjust. Never commit .env.

# Port the app is published on (container always listens on 8080).
APP_PORT=8080

# PostgreSQL (used by the app from milestone M3 on; the service is already part
# of the compose stack so the local environment is stable from day one).
POSTGRES_DB=einvoice
POSTGRES_USER=einvoice
# Required — no default. Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Keycloak (identity provider, joins the stack at M3). Dev mode, realm auto-imported
# from keycloak/dev-realm.json. These bootstrap the Keycloak admin account and are
# required — no default (like POSTGRES_PASSWORD). They are the master-admin login for
# the local Keycloak only; the app itself authenticates via the imported realm, not these.
KEYCLOAK_ADMIN=
# Required — no default. Generate one:  openssl rand -base64 24
KEYCLOAK_ADMIN_PASSWORD=
# Host port Keycloak is published on (container listens on 8080). The app derives its
# OAUTH2_ISSUER_URI (http://localhost:<this>/realms/einvoice) from it in docker-compose.yml.
KEYCLOAK_PORT=8081

# Optional: require every access token's `aud` claim to contain this value (typically the API's
# Keycloak client id). Signature and issuer prove a token is genuine, not that it was minted FOR
# this API — set this on any shared or production realm. Left blank for the local dev realm,
# whose tokens carry Keycloak's default `account` audience. See docs/adr/0006.
OAUTH2_AUDIENCE=

# Mailpit (local SMTP sink, joins the stack at M3; consumed by the app from M5).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
