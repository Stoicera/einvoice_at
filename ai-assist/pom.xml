<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.stoicera.einvoice</groupId>
    <artifactId>einvoice-at</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ai-assist</artifactId>

  <name>einvoice-at :: ai-assist</name>

  <dependencies>
    <!-- The canonical model, for Finding/Severity: an explanation explains a validator finding, so
         that record is this module's input type. Project module; reactor-versioned. -->
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- JSON for the OpenRouter request/response bodies. Classic Jackson 2
         (com.fasterxml.jackson.core), the same major this repository's other library module uses
         (see mapping/pom.xml) rather than the Jackson 3 that app gets from Boot — a lib module
         picks the boring, already-present option. Version from the spring-boot-starter-parent BOM,
         never pinned here.

         There is deliberately no HTTP client dependency: the adapter uses the JDK's own
         java.net.http.HttpClient, so this module stays free of a client library that would have to
         be kept in step with Boot's. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Logging FACADE only — the first library module in this repository to take one, so it is a
         deliberate choice rather than a habit. This module's contract is that a provider failure
         degrades silently for the user (FindingExplainer never throws); without a log, "silently"
         would extend to the operator too, and an AI provider that has been failing for a week would
         look exactly like a feature nobody clicked. slf4j-api is the facade
         ENGINEERING_STANDARDS §5 names, carries no binding of its own, and leaves the choice of
         backend to app (Logback, ECS JSON under the prod profile). Version Boot-managed. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Property-based tests for the PII scrubber: the interesting claim ("no IBAN survives") is
         universally quantified over generated text, which is exactly what jqwik expresses.
         Version/scope managed in the root POM. -->
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.85</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Mutation testing, same wiring and same "-pl ai-assist without -am" caveat as the other
         gated modules (see mapping/pom.xml for the full explanation). Run locally with
         ./mvnw -pl ai-assist -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage
         This module earns a PIT gate: the scrubber and the retry/cache logic are exactly the kind
         of small, branch-dense, security-relevant code where line coverage alone proves little. -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>com.stoicera.einvoice.aiassist.*</param>
              </targetClasses>
              <!-- Gate 85, mirroring the other adapter-shaped modules. Measured value recorded in
                   docs/worklog.md for the milestone that set it. -->
              <mutationThreshold>85</mutationThreshold>
              <timestampedReports>false</timestampedReports>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
