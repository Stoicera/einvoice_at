<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.stoicera.einvoice</groupId>
    <artifactId>einvoice-at</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>app</artifactId>

  <name>einvoice-at :: app</name>

  <properties>
    <!-- Default so Failsafe's <argLine> resolves even when JaCoCo's prepare-agent-integration has
         not run (e.g. `./mvnw test -pl app`, which skips the integration phases entirely). The
         real value is injected by that execution. -->
    <failsafeArgLine/>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Bean Validation (Jakarta) for the request DTOs the invoices/validate APIs add later.
         Version Boot-managed. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Observability (M6, ADR-0012): OpenTelemetry traces AND metrics, both exported over OTLP.

         ONE starter rather than four hand-picked artifacts. It brings micrometer-tracing-bridge-otel
         (so a Micrometer Observation becomes an OTel span), opentelemetry-exporter-otlp (the span
         exporter), micrometer-registry-otlp (the metric registry) and Boot's auto-configuration for
         all of it — every version managed by the Boot parent through the micrometer-tracing and
         opentelemetry BOMs it already imports.

         DELIBERATELY NO PROMETHEUS SCRAPE ENDPOINT. Both signals push over OTLP, which means there
         is exactly one mechanism to configure, one to document and one to get wrong — and, more to
         the point, no new anonymous surface to secure: /actuator/** is authenticated (SecurityConfig)
         except the health probes, so a scrape endpoint would have needed either a credential for
         Prometheus or a hole in that rule. Prometheus 3 ingests OTLP directly (its
         web.enable-otlp-receiver flag, see the observability compose profile), so the scrape model
         buys nothing here. ENGINEERING_STANDARDS §5 names OTLP export as an acceptable shape.

         INERT UNLESS SWITCHED ON: application.yml gates both exporters on OTEL_ENABLED (default
         false) — see the comment there for why the Boot defaults would otherwise have every
         deployment posting to localhost:4318 forever. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <!-- Persistence: Spring Data JPA (Hibernate ORM 7 via Boot 4.1's dependencyManagement). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Schema migrations. Boot 4 split each technology's auto-configuration into its own module,
         so a bare flyway-core does NOT bring Boot's FlywayAutoConfiguration (Flyway then never runs).
         spring-boot-starter-flyway pulls that auto-configuration module together with flyway-core;
         flyway-database-postgresql adds the Postgres-specific database support Flyway 10+ splits out
         of core. All versions Boot-managed. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- PostgreSQL JDBC driver. Runtime scope: the app codes to JPA/Spring, never to the driver
         API directly. Version Boot-managed. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Security. Boot 4 split each technology's auto-configuration into its own module (the same
         packaging change the persistence baseline hit with Flyway/Testcontainers — see ADR-0005).
         spring-boot-starter-security pulls the `spring-boot-security` auto-configuration together
         with spring-security-web/-config; spring-boot-starter-oauth2-resource-server pulls the
         `spring-boot-security-oauth2-resource-server` auto-configuration plus the JOSE/Nimbus stack
         for JWT validation. All versions Boot-managed (spring-security 7.1 via the imported BOM). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- OAuth2 CLIENT (not resource server): the browser half of the platform logs in with the
         authorization-code flow against Keycloak, which is a different role than validating a bearer
         token someone else minted. Both live side by side in SecurityConfig's two filter chains —
         see ADR-0009 for why two chains rather than one widened one. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <!-- Server-rendered HTML (SPEC §5). Thymeleaf only — no CSS or JS build step: the stylesheet is
         hand authored and the ~50 lines of progressive enhancement are first-party. ADR-0009 records
         why, including the deliberate deviation from SPEC §1's Tailwind standalone CLI. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <!-- Thymeleaf/Spring Security integration: sec:authorize and #authentication in templates, so a
         template never has to be handed "is this user logged in" as a model attribute the controller
         computed. Version Boot-managed. -->
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>
    <!-- AI-assisted finding explanations, behind features.ai-explanations (SPEC §2/§6). Reactor-
         versioned sibling; it is plain Java, so app owns every bean it becomes. -->
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>ai-assist</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Per-IP token-bucket rate limiting for the anonymous side of POST /api/v1/validate
         (RateLimitFilter, T8). Version parent-managed (see the root POM's bucket4j.version
         comment for the Maven Central verification). Dependency-free beyond the JDK. -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j-core</artifactId>
    </dependency>
    <!-- OpenAPI document + Swagger UI (OpenApiConfig, T9): generates /v3/api-docs from the
         controllers below and serves /swagger-ui/**, both permitted anonymously by
         SecurityConfig. Version parent-managed (see the root POM's springdoc-openapi.version
         comment for the Maven Central verification and Boot-4.1 compatibility basis). -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <!-- Library modules the app composes as the milestone's REST layer lands on top of this
         persistence baseline: canonical model + JSON boundary (core, mapping), ebInterface XML
         generation (formats-ebinterface) and the validation pipeline (validation). Reactor-versioned
         siblings, never pinned here. Their Spring-free packages sit OUTSIDE com.stoicera.einvoice.app,
         so component scanning never picks them up — they are plain classpath libraries. -->
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>mapping</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>validation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>formats-ebinterface</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- UBL 2.1 read/write for the conversion endpoint and the UBL invoice output (M4).
         Reactor-versioned sibling. -->
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>formats-ubl</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- PDF print view for GET /invoices/{id}/pdf (M4). Reactor-versioned sibling; it brings
         PDFBox, which is why the app can render without knowing anything about PDF itself. -->
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>rendering</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- ph-ebinterface pulls only the Jakarta XML Binding API; the JAXB runtime provider must be
         supplied by the module that actually marshals ebInterface XML at runtime — that is the app,
         once the invoices API writes XML. Opt-in exactly as formats-ebinterface does. Version
         parent-managed. -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TestObservationRegistry + SimpleTracer, so the M6 instrumentation is asserted rather than
         eyeballed in a Grafana screenshot: a test can state "this pipeline produced exactly these
         stages, in this order, each once". Test scope; version from the Boot parent. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Security's own test support, for the M5 dashboard ITs. Version managed by the Boot
         parent; test scope only.

         Needed because the dashboard sits on the BROWSER filter chain, which authenticates a cookie
         session established by an OAuth2 authorization-code login — it deliberately does not accept
         the bearer tokens and X-Api-Keys every other IT in this module uses (SecurityConfig, ADR-0009).
         Driving a real Keycloak login form over HttpClient to reach a page assertion would test
         Keycloak; SecurityMockMvcRequestPostProcessors.oauth2Login() injects the authentication the
         real flow would have produced and lets the test assert the page. The real authorization-code
         flow is covered where it belongs — end to end in a real browser against a real Keycloak, in
         the e2e module. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- MockMvc's Boot autoconfiguration (@AutoConfigureMockMvc), which the dashboard ITs drive.
         NOTE: Boot 4.1's module split moved this out of spring-boot-test-autoconfigure into its own
         module, and the annotation with it — org.springframework.boot.test.autoconfigure.web.servlet
         .AutoConfigureMockMvc no longer exists; it is now
         org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc. The module is
         declared directly rather than via spring-boot-starter-webmvc-test, which would also pull in
         spring-boot-starter-webmvc and resttestclient for nothing. Version from the Boot parent. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers: Boot's @ServiceConnection support + the Postgres module. Versions come
         from Boot 4.1's testcontainers BOM import (testcontainers-bom 2.0.5), never pinned.
         NOTE: Boot 4.1 ships Testcontainers 2.x, which renamed the Maven modules from the 1.x
         "postgresql"/"junit-jupiter" the task brief listed to "testcontainers-postgresql"/
         "testcontainers-junit-jupiter". The 2.x coordinates are used here. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers core, for the plain GenericContainer that runs Keycloak in the auth ITs.
         Already present transitively via testcontainers-postgresql; declared directly because the
         Keycloak IT base uses GenericContainer's API first-hand. Version from Boot's testcontainers
         BOM (2.0.5). See docs/adr/0005 for why the Keycloak container is a hand-rolled GenericContainer
         rather than the dasniko/testcontainers-keycloak helper (verified Testcontainers-2.x-compatible
         at 4.3.1, but it drags keycloak-admin-client, a beta shrinkwrap and a second Jackson onto the
         test classpath for features this task does not use). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ArchUnit: the first cross-module rule set (T10, SPEC §2) lives here rather than in a
         lib module, since it is app's test classpath (app + every lib module it depends on) that
         gives it visibility across the whole com.stoicera.einvoice tree. Scope test, matching the
         other modules' ArchitectureTests (version/scope managed in the root POM). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <!-- "Which build is this?" — SPEC §9's version endpoint, an open carry item since M4.
           /actuator/info reads git.properties (below) and build-info.properties (the `build-info`
           goal on spring-boot-maven-plugin), and simply omits whichever is absent.

           <failOnNoGitDirectory>false</failOnNoGitDirectory> is NOT here on purpose. It would make
           the interesting case — the container image, which is the artifact actually deployed and
           therefore the one whose identity anyone ever needs to ask about — silently ship without a
           commit id, because .dockerignore excluded `.git` from the build context. The fix is on the
           other side: `.git` is now part of the context (2 MB against an 8 MB source tree) so the
           in-image build resolves a real sha, and a build that genuinely has no git metadata fails
           loudly instead of producing an image that cannot say what it is. -->
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <version>${git-commit-id-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>get-the-git-infos</id>
            <goals>
              <goal>revision</goal>
            </goals>
            <phase>initialize</phase>
          </execution>
        </executions>
        <configuration>
          <generateGitPropertiesFile>true</generateGitPropertiesFile>
          <generateGitPropertiesFilename>
            ${project.build.outputDirectory}/git.properties
          </generateGitPropertiesFilename>
          <!-- Exactly the keys management.info.git.mode=simple publishes (git.commit.id and
               git.commit.time), plus the abbreviated id because that is the form a human quotes.
               The plugin's default set includes the branch name, the committer's name and e-mail
               address and the full commit message; /actuator/info is authenticated, but
               "authenticated" is not a reason to publish the people who wrote the code.

               The patterns escape their dots. `^git.commit.id$` would also match `gitXcommitYidZ` —
               harmless in practice and wrong as a statement of intent. -->
          <includeOnlyProperties>
            <includeOnlyProperty>^git\.commit\.id$</includeOnlyProperty>
            <includeOnlyProperty>^git\.commit\.id\.abbrev$</includeOnlyProperty>
            <includeOnlyProperty>^git\.commit\.time$</includeOnlyProperty>
          </includeOnlyProperties>
          <!-- Reproducible across timezones, and the same shape build-info.properties uses. -->
          <dateFormat>yyyy-MM-dd'T'HH:mm:ssXXX</dateFormat>
          <dateFormatTimeZone>UTC</dateFormatTimeZone>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- build-info.properties: artifact, version and build time, the other half of
               /actuator/info. `repackage` is bound by the Boot parent already; naming it here would
               replace that default binding rather than add to it, so only build-info is declared. -->
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- The executable fat jar gets a CLASSIFIER, so the plain jar stays this module's main
               Maven artifact.

               Without this, `repackage` REPLACES app.jar with the executable one, whose classes live
               under BOOT-INF/classes — invisible to a normal compile classpath. Any module depending
               on `app` then resolves the fat jar and cannot see a single one of its classes: the
               `e2e` module failed exactly that way, and the error ("cannot find symbol
               ReportRepository", while classes from the test-jar resolved fine) points at the source
               file rather than at the packaging.

               Consequence to keep in step: the runtime jar is now app-exec.jar, which is what the
               Dockerfile copies. -->
          <classifier>exec</classifier>
        </configuration>
      </plugin>
      <!-- Test split by naming convention: Surefire (bound to `test`) runs the fast, Docker-free
           unit tests (`*Test`/`*Tests`); Failsafe (bound to `integration-test`/`verify`) runs the
           Testcontainers integration tests (`*IT`, the default Failsafe include). So
           `./mvnw test -pl app` needs no Docker daemon, while `./mvnw verify -pl app` spins up the
           Postgres and Keycloak containers. The `verify` goal makes the build fail on IT failures
           (Failsafe defers failures to it), which the reactor `verify` in CI already runs. Abstract
           bases (AbstractPostgresIT, AbstractKeycloakIT) carry no @Test and are skipped regardless. -->
      <!-- Publishes app's test classes as a test-jar so the `e2e` module can reuse
           AbstractPostgresIT and MultipartBodies instead of re-declaring the Testcontainers wiring.
           Two copies of that wiring would be two things to keep in step, and the E2E stack must boot
           the same context the integration tests boot or it is testing something else. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- Set by JaCoCo's prepare-agent-integration below, so the integration tests run under
               the coverage agent too (Failsafe does not pick up `argLine` the way Surefire does).
               @{...}, not ${...}: the late-binding form is resolved when the fork is launched,
               after prepare-agent-integration has written the property. With ${...} the value is
               interpolated while the POM is read — before that execution runs — so the agent is
               silently absent and the IT coverage file is never written at all. -->
          <argLine>@{failsafeArgLine}</argLine>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Coverage gate. The other four implemented modules have carried one since M1/M2; `app`
           shipped M3 — every line of security, tenancy, persistence and error handling — with none
           at all, which the M3 hostile review flagged (F4).

           Unlike those modules, most of app's behaviour is proven by integration tests rather than
           unit tests, so a single prepare-agent would measure only the Surefire half and report a
           misleadingly low number. Both runs are therefore instrumented into separate exec files
           and merged before the report and the check, so the gate sees the coverage the whole suite
           actually produces.

           Thresholds are set from the measured value with a deliberate margin, not aspirationally:
           they exist to catch a regression, and a gate nobody can pass gets weakened, which is
           worse than no gate. Measured 95.24 % line / 83.33 % branch at the M3 fix wave, gated at
           90/78. PIT is not applied here (unlike core/mapping/validation/
           formats-ebinterface): mutating a Spring module whose tests each boot a context and two
           containers costs minutes per mutant for little signal, and the module's genuinely
           algorithmic parts — ApiKeys, RateLimitFilter — are the ones already covered by fast unit
           tests. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco-unit.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>prepare-agent-integration</id>
            <goals>
              <goal>prepare-agent-integration</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco-it.exec</destFile>
              <propertyName>failsafeArgLine</propertyName>
            </configuration>
          </execution>
          <execution>
            <id>merge-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}</directory>
                  <includes>
                    <include>jacoco-unit.exec</include>
                    <include>jacoco-it.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
            </configuration>
          </execution>
          <execution>
            <id>check-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.78</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
