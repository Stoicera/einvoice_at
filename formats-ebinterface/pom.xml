<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.stoicera.einvoice</groupId>
    <artifactId>einvoice-at</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>formats-ebinterface</artifactId>

  <name>einvoice-at :: formats-ebinterface</name>

  <dependencies>
    <!-- ebInterface 6.1 JAXB types + marshallers by Philip Helger. Version pinned by the
         parent dependencyManagement (8.1.0); never redeclare it here. -->
    <dependency>
      <groupId>com.helger</groupId>
      <artifactId>ph-ebinterface</artifactId>
    </dependency>
    <!-- ph-ebinterface pulls only the Jakarta XML Binding API; the JAXB runtime provider
         must be supplied here for marshalling/unmarshalling to work. Version parent-managed. -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.85</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Mutation testing gives the coverage number teeth; run locally with
         ./mvnw -pl formats-ebinterface -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage
         Deliberately NOT "-am": the bare pitest goal runs against every project the reactor
         selects, so "-am" would drag core into the same reactor. All four gated modules now carry
         the profile, so the CI job (ci.yml) lists them together, but it still installs the
         dependency closure first and runs the goal without "-am" — see mapping/pom.xml's
         reactor-landmine note.
         Kept out of the default verify because PIT re-runs the suite once per mutant. -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>com.stoicera.einvoice.formats.ebinterface.*</param>
              </targetClasses>
              <!-- Measured mutation score 13/13 (100%) on 2026-07-24; a full run takes ~7 s. Gate
                   set to 85 rather than 100: with only 13 mutants each is worth ~7.7 points, so a
                   single future benign survivor would drop the score to 92 % — 85 leaves that
                   headroom (mirroring mapping's gate) while still tripping on a real regression.
                   This module runs no jqwik property tests, so the score is deterministic. -->
              <mutationThreshold>85</mutationThreshold>
              <timestampedReports>false</timestampedReports>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
