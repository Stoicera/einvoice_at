{
  "realm": "einvoice",
  "enabled": true,
  "displayName": "einvoice-at (dev)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "einvoice-api",
      "name": "einvoice-at API (dev)",
      "description": "DEV/TEST ONLY confidential client. Direct access grants are enabled so dev and the ITs can fetch a token with username/password; the secret below is public and dev-only. Never reuse in a deployed environment.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-einvoice-api-secret-not-for-production",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true
    },
    {
      "clientId": "einvoice-web",
      "name": "einvoice-at web UI (dev only)",
      "description": "Authorization-code client for the M5 browser surface. Dev-only credentials; see docs/adr/0009-web-ui.md.",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-einvoice-web-secret-not-for-production",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser@einvoice.test",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ]
    }
  ]
}