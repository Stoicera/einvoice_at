<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.stoicera.einvoice</groupId>
  <artifactId>einvoice-at</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>einvoice-at</name>
  <description>Austrian e-invoicing platform: generate, validate and convert ebInterface 6.1 and Peppol BIS Billing 3.0 UBL</description>
  <url>https://github.com/Stoicera/einvoice_at</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <module>core</module>
    <module>formats-ebinterface</module>
    <module>formats-ubl</module>
    <module>mapping</module>
    <module>validation</module>
    <module>rendering</module>
    <module>ai-assist</module>
    <module>app</module>
  </modules>

  <properties>
    <java.version>25</java.version>

    <!-- e-invoice standards artefacts by Philip Helger (https://github.com/phax).
         Versions verified against Maven Central on 2026-07-23; this set is mutually
         compatible: phive-rules-parent-pom 4.4.1 itself builds against
         ph-ebinterface 8.1.0, ph-ubl 10.2.0 and phive 12.1.0. -->
    <ph-ebinterface.version>8.1.0</ph-ebinterface.version>
    <ph-ubl.version>10.2.0</ph-ubl.version>
    <phive.version>12.1.0</phive.version>
    <phive-rules.version>4.4.1</phive-rules.version>

    <!-- The ph-* stack depends on the Jakarta XML Binding API only (jakarta.xml.bind-api,
         pulled transitively at 4.0.x); a JAXB runtime provider must be supplied by the
         consuming module. glassfish jaxb-runtime 4.0.5 matches the jakarta.xml.bind-api 4.0.5
         that ph-jaxb 12.1.0 brings in. -->
    <jaxb-runtime.version>4.0.5</jaxb-runtime.version>

    <spotless-maven-plugin.version>3.8.0</spotless-maven-plugin.version>
    <google-java-format.version>1.35.0</google-java-format.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <jqwik.version>1.10.1</jqwik.version>
    <archunit.version>1.4.2</archunit.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>

    <!-- Mutation testing. Versions verified against Maven Central maven-metadata.xml
         on 2026-07-24 (the solrsearch API reports a stale latest). pitest 1.25.8 bundles
         ASM 9.10.1, which reads class-file major version 69 (Java 25 bytecode);
         pitest-junit5-plugin 1.2.3 requires pitest 1.19.4+, so the pair is compatible. -->
    <pitest.version>1.25.8</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>

    <!-- In-memory rate limiting (app's RateLimitFilter, T8). Version verified against Maven
         Central maven-metadata.xml on 2026-07-24 (the solrsearch API is fine here too, but
         metadata.xml is this repo's convention — see the pitest note above); 8.10.1 is both
         <latest> and <release>, groupId com.bucket4j, artifactId bucket4j-core, Apache-2.0.
         Java package is io.github.bucket4j (a historical mismatch with the com.bucket4j Maven
         coordinates, not a typo). No newer release since 2024-03; the project appears dormant
         but the jar is stable and dependency-free (no transitive pulls beyond the JDK). -->
    <bucket4j.version>8.10.1</bucket4j.version>

    <!-- OpenAPI documentation / Swagger UI for the REST API (app, T9). Version verified against
         Maven Central maven-metadata.xml on 2026-07-24: 3.0.3 is both <latest> and <release>,
         groupId org.springdoc, artifactId springdoc-openapi-starter-webmvc-ui, Apache-2.0.
         Boot-4.1 compatibility check: that artifact's POM parent (org.springdoc:springdoc-openapi:
         3.0.3) itself pins spring-boot-starter-parent 4.0.5, i.e. spring-framework.version 7.0.6
         (per spring-boot-dependencies 4.0.5's POM); this repo's parent is Boot 4.1.0, whose
         spring-boot-dependencies POM pins spring-framework.version 7.0.8 — the same Framework
         7.0.x line, a patch-only delta (7.0.6 -> 7.0.8), not a minor/major jump. No 3.0.x release
         built against Boot 4.1 exists yet, but springdoc's webmvc integration only touches stable
         Spring MVC / actuator SPI surfaces that do not change across a framework patch revision,
         so 3.0.3 is the correct pin; empirically confirmed working via OpenApiIT (app/src/test/.../
         api/OpenApiIT.java) against the real Boot 4.1.0 context. -->
    <springdoc-openapi.version>3.0.3</springdoc-openapi.version>

    <!-- Reactor-wide defaults for org.codehaus.mojo:exec-maven-plugin's `java` goal (used by the
         validation module's ValidationRunner CLI): skipped everywhere except where a module opts
         back in with its own <skip>false</skip>. Both properties are needed, not just exec.skip:
         `exec:java` invoked bare on the command line (not bound to a lifecycle phase) runs
         against every project the reactor selects, not just the one that declares the plugin —
         e.g. `mvn -pl validation -am compile exec:java` also pulls in this root aggregator and
         validation's other module dependencies. Maven validates the plugin's required
         `mainClass` parameter before the mojo's own `skip` check ever runs, so `exec.skip` alone
         is not enough to save those other projects from failing the build; giving every project
         a mainClass value up front satisfies that validation. The value here is a deliberate
         no-op placeholder — those projects never execute it, because exec.skip short-circuits — so
         the parent no longer names the validation-internal CLI class (finding A9); the real
         `exec.mainClass` lives in validation/pom.xml, which overrides this for the one project that
         actually runs the goal. -->
    <exec.skip>true</exec.skip>
    <exec.mainClass>none.Skip</exec.mainClass>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.helger</groupId>
        <artifactId>ph-ebinterface</artifactId>
        <version>${ph-ebinterface.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.ubl</groupId>
        <artifactId>ph-ubl21</artifactId>
        <version>${ph-ubl.version}</version>
      </dependency>
      <dependency>
        <groupId>org.glassfish.jaxb</groupId>
        <artifactId>jaxb-runtime</artifactId>
        <version>${jaxb-runtime.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>com.helger.phive</groupId>
        <artifactId>phive-api</artifactId>
        <version>${phive.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phive</groupId>
        <artifactId>phive-xml</artifactId>
        <version>${phive.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phive.rules</groupId>
        <artifactId>phive-rules-ebinterface</artifactId>
        <version>${phive-rules.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phive.rules</groupId>
        <artifactId>phive-rules-peppol</artifactId>
        <version>${phive-rules.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bucket4j</groupId>
        <artifactId>bucket4j-core</artifactId>
        <version>${bucket4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc-openapi.version}</version>
      </dependency>
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
