<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.stoicera.einvoice</groupId>
  <artifactId>einvoice-at</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>einvoice-at</name>
  <description>Austrian e-invoicing platform: generate, validate and convert ebInterface 6.1 and Peppol BIS Billing 3.0 UBL</description>
  <url>https://github.com/Stoicera/einvoice_at</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <module>core</module>
    <module>formats-api</module>
    <module>formats-ebinterface</module>
    <module>formats-ubl</module>
    <module>mapping</module>
    <module>validation</module>
    <module>rendering</module>
    <module>ai-assist</module>
    <module>app</module>
    <!-- Browser E2E and the Gatling load scenario (ENGINEERING_STANDARDS §3). Always compiled by a
         plain `./mvnw verify` so it cannot rot, but its tests do not RUN unless -Pe2e is active —
         they need a Chrome container and a load profile, which belong in their own CI job next to
         the mutation and security jobs rather than in every developer's inner loop. See e2e/pom.xml. -->
    <module>e2e</module>
  </modules>

  <properties>
    <java.version>25</java.version>

    <!-- e-invoice standards artefacts by Philip Helger (https://github.com/phax).
         Versions verified against Maven Central on 2026-07-23; this set is mutually
         compatible: phive-rules-parent-pom 4.4.1 itself builds against
         ph-ebinterface 8.1.0, ph-ubl 10.2.0 and phive 12.1.0. -->
    <ph-ebinterface.version>8.1.0</ph-ebinterface.version>
    <ph-ubl.version>10.2.0</ph-ubl.version>
    <phive.version>12.1.0</phive.version>
    <phive-rules.version>4.4.1</phive-rules.version>

    <!-- The ph-* stack depends on the Jakarta XML Binding API only (jakarta.xml.bind-api,
         pulled transitively at 4.0.x); a JAXB runtime provider must be supplied by the
         consuming module. glassfish jaxb-runtime 4.0.5 matches the jakarta.xml.bind-api 4.0.5
         that ph-jaxb 12.1.0 brings in. -->
    <jaxb-runtime.version>4.0.5</jaxb-runtime.version>

    <!-- SECURITY OVERRIDES of versions spring-boot-dependencies 4.1.0 manages.

         Both raise a dependency the OWASP scan flagged at CVSS >= 7 on the first run after the
         NVD_API_KEY secret was configured (2026-07-25) — i.e. the gate's first real verdict, not a
         hypothetical. Upgrading is the required first response; suppressing a genuine finding to
         get a green build is what .owasp-suppressions.xml's own policy forbids.

         Boot 4.1.0 is the newest release at this date, so there is no parent bump that carries
         these fixes; the properties are overridden here instead, which is the mechanism
         spring-boot-dependencies documents for exactly this. Both versions verified against Maven
         Central maven-metadata.xml on 2026-07-25 as <latest> and <release>. Drop these overrides
         once a Boot release manages versions at least this high — leaving them pinned below Boot's
         own floor would silently downgrade. -->
    <postgresql.version>42.7.13</postgresql.version>
    <tomcat.version>11.0.24</tomcat.version>

    <!-- PDF generation for the rendering module (M4). Version verified against Maven Central
         maven-metadata.xml on 2026-07-25: 3.0.8 is both <latest> and <release>. Apache-2.0, the
         same licence as this repository — which is why PDFBox and not OpenPDF, whose LGPL/MPL dual
         licence would add a licence-compatibility question to a portfolio repo for no gain. SPEC §1
         names both as acceptable; see ADR-0008 for the full comparison, including why an HTML→PDF
         stack (openhtmltopdf) was not chosen. -->
    <pdfbox.version>3.0.8</pdfbox.version>

    <!-- OWASP Dependency-Check (ENGINEERING_STANDARDS §4 and §6: "Dependency-Scanning in CI:
         Dependabot + OWASP Dependency-Check"). Version verified against Maven Central
         maven-metadata.xml on 2026-07-25: 12.2.2 is both <latest> and <release>. -->
    <dependency-check-maven.version>12.2.2</dependency-check-maven.version>

    <!-- Fail the security scan on anything CVSS 7.0 or above (the CVSS v3 "High" floor). Not 0:
         a gate that trips on every informational advisory gets switched off, which is worse than
         no gate. Anything below the floor still appears in the report — the scan is a report with
         a threshold, not a filter. -->
    <dependency-check.failBuildOnCVSS>7</dependency-check.failBuildOnCVSS>

    <spotless-maven-plugin.version>3.8.0</spotless-maven-plugin.version>
    <google-java-format.version>1.35.0</google-java-format.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <jqwik.version>1.10.1</jqwik.version>
    <archunit.version>1.4.2</archunit.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>

    <!-- Mutation testing. Versions verified against Maven Central maven-metadata.xml
         on 2026-07-24 (the solrsearch API reports a stale latest). pitest 1.25.8 bundles
         ASM 9.10.1, which reads class-file major version 69 (Java 25 bytecode);
         pitest-junit5-plugin 1.2.3 requires pitest 1.19.4+, so the pair is compatible. -->
    <pitest.version>1.25.8</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>

    <!-- In-memory rate limiting (app's RateLimitFilter, T8). Version verified against Maven
         Central maven-metadata.xml on 2026-07-24 (the solrsearch API is fine here too, but
         metadata.xml is this repo's convention — see the pitest note above); 8.10.1 is both
         <latest> and <release>, groupId com.bucket4j, artifactId bucket4j-core, Apache-2.0.
         Java package is io.github.bucket4j (a historical mismatch with the com.bucket4j Maven
         coordinates, not a typo). No newer release since 2024-03; the project appears dormant
         but the jar is stable and dependency-free (no transitive pulls beyond the JDK). -->
    <bucket4j.version>8.10.1</bucket4j.version>

    <!-- OpenAPI documentation / Swagger UI for the REST API (app, T9). Version verified against
         Maven Central maven-metadata.xml on 2026-07-24: 3.0.3 is both <latest> and <release>,
         groupId org.springdoc, artifactId springdoc-openapi-starter-webmvc-ui, Apache-2.0.
         Boot-4.1 compatibility check: that artifact's POM parent (org.springdoc:springdoc-openapi:
         3.0.3) itself pins spring-boot-starter-parent 4.0.5, i.e. spring-framework.version 7.0.6
         (per spring-boot-dependencies 4.0.5's POM); this repo's parent is Boot 4.1.0, whose
         spring-boot-dependencies POM pins spring-framework.version 7.0.8 — the same Framework
         7.0.x line, a patch-only delta (7.0.6 -> 7.0.8), not a minor/major jump. No 3.0.x release
         built against Boot 4.1 exists yet, but springdoc's webmvc integration only touches stable
         Spring MVC / actuator SPI surfaces that do not change across a framework patch revision,
         so 3.0.3 is the correct pin; empirically confirmed working via OpenApiIT (app/src/test/.../
         api/OpenApiIT.java) against the real Boot 4.1.0 context. -->
    <springdoc-openapi.version>3.0.3</springdoc-openapi.version>

    <!-- Reactor-wide defaults for org.codehaus.mojo:exec-maven-plugin's `java` goal (used by the
         validation module's ValidationRunner CLI): skipped everywhere except where a module opts
         back in with its own <skip>false</skip>. Both properties are needed, not just exec.skip:
         `exec:java` invoked bare on the command line (not bound to a lifecycle phase) runs
         against every project the reactor selects, not just the one that declares the plugin —
         e.g. `mvn -pl validation -am compile exec:java` also pulls in this root aggregator and
         validation's other module dependencies. Maven validates the plugin's required
         `mainClass` parameter before the mojo's own `skip` check ever runs, so `exec.skip` alone
         is not enough to save those other projects from failing the build; giving every project
         a mainClass value up front satisfies that validation. The value here is a deliberate
         no-op placeholder — those projects never execute it, because exec.skip short-circuits — so
         the parent no longer names the validation-internal CLI class (finding A9); the real
         `exec.mainClass` lives in validation/pom.xml, which overrides this for the one project that
         actually runs the goal. -->
    <exec.skip>true</exec.skip>
    <exec.mainClass>none.Skip</exec.mainClass>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.helger</groupId>
        <artifactId>ph-ebinterface</artifactId>
        <version>${ph-ebinterface.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.ubl</groupId>
        <artifactId>ph-ubl21</artifactId>
        <version>${ph-ubl.version}</version>
      </dependency>
      <dependency>
        <groupId>org.glassfish.jaxb</groupId>
        <artifactId>jaxb-runtime</artifactId>
        <version>${jaxb-runtime.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>com.helger.phive</groupId>
        <artifactId>phive-api</artifactId>
        <version>${phive.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phive</groupId>
        <artifactId>phive-xml</artifactId>
        <version>${phive.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phive.rules</groupId>
        <artifactId>phive-rules-ebinterface</artifactId>
        <version>${phive-rules.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phive.rules</groupId>
        <artifactId>phive-rules-peppol</artifactId>
        <version>${phive-rules.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
        <version>${pdfbox.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bucket4j</groupId>
        <artifactId>bucket4j-core</artifactId>
        <version>${bucket4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc-openapi.version}</version>
      </dependency>
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Security scan, ENGINEERING_STANDARDS §4/§6. Run it with:
             ./mvnw -Psecurity verify
         (or the dedicated CI job, which is where it normally runs).

         DELIBERATELY A PROFILE, NOT BOUND TO THE DEFAULT BUILD. Dependency-Check works against a
         local copy of the NVD, and keeping that copy current is minutes of network I/O, not
         seconds. Binding it to `verify` would make every local `./mvnw verify` unusable and would
         blow ENGINEERING_STANDARDS §6's own "build under 10 minutes" budget — so it is its own
         pipeline stage, exactly as that section lays the stages out.

         NVD_API_KEY IS EFFECTIVELY REQUIRED. Since the NVD moved to its 2.0 API, an unauthenticated
         client is rate-limited hard enough that a first sync takes the better part of an hour and
         often fails outright. The key is free (nvd.nist.gov/developers/request-an-api-key) and is
         read from the environment here; CI passes it from a repository secret. Without it the scan
         still runs, just slowly and unreliably — which is a fact about the NVD, not about this
         configuration, and is why the CI job says so out loud when the secret is missing rather
         than failing with a puzzling HTTP 403. -->
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check-maven.version}</version>
            <!-- ROOT MODULE ONLY — this is load-bearing, not tidiness (M4 hostile review, F1).

                 A parent's <build><plugins> is inherited by every child module, and a profile
                 defined here is injected into the parent model the children then inherit. Without
                 this flag `-Psecurity verify` therefore ran the `aggregate` goal in all nine
                 modules instead of once at the root: the executions share one CveDB, the first one
                 closes it, and every execution after that fails per CVE with
                 "Cannot invoke BasicDataSource.getConnection() because this.connectionPool is
                 null" — hundreds of them, which is what turned the security stage red while the
                 diagnosis pointed at a missing NVD_API_KEY instead.

                 `aggregate` already walks the whole reactor's dependency closure from the root, so
                 one execution is not a compromise: it is what the goal is for. The CI job re-checks
                 this by asserting a child module's effective POM does not contain the plugin, so a
                 future edit cannot silently reintroduce the inheritance. -->
            <inherited>false</inherited>
            <configuration>
              <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
              <failBuildOnCVSS>${dependency-check.failBuildOnCVSS}</failBuildOnCVSS>
              <suppressionFiles>
                <suppressionFile>${maven.multiModuleProjectDirectory}/.owasp-suppressions.xml</suppressionFile>
              </suppressionFiles>
              <formats>
                <format>HTML</format>
                <format>SARIF</format>
              </formats>
              <!-- Test-only dependencies are not shipped and cannot be reached by an attacker
                   through the running application; including them turns the report into noise
                   about JUnit and Testcontainers. Provided scope stays in: it is on the runtime
                   classpath of whatever container hosts the app. -->
              <skipTestScope>true</skipTestScope>
              <!-- Provided scope is NOT skipped: a provided dependency is absent from the build's
                   output but present on the runtime classpath of whatever container hosts the app,
                   so an attacker reaches it exactly as they would a compile-scope one. Spelled out
                   explicitly rather than left to the plugin default, because "provided" reads like
                   "someone else's problem" and here it is not. -->
              <skipProvidedScope>false</skipProvidedScope>
            </configuration>
            <executions>
              <execution>
                <id>dependency-check</id>
                <phase>verify</phase>
                <goals>
                  <!-- `aggregate`, not `check`: it walks the whole reactor's dependency closure
                       from the root and writes one report. Paired with <inherited>false</inherited>
                       above, that is one execution covering nine modules. -->
                  <goal>aggregate</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
