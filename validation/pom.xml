<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.stoicera.einvoice</groupId>
    <artifactId>einvoice-at</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>validation</artifactId>

  <name>einvoice-at :: validation</name>

  <properties>
    <!-- CLI runner (ValidationRunner) driven via `exec:java` for fast corpus smoke runs, outside
         the app module's Spring context. Version verified against Maven Central
         maven-metadata.xml on 2026-07-24: latest and release both 3.6.3. -->
    <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    <!-- The real exec.mainClass lives here, in the one module that owns the CLI, overriding the
         root POM's no-op placeholder (finding A9). This is the only project where `exec:java`
         actually runs. -->
    <exec.mainClass>com.stoicera.einvoice.validation.cli.ValidationRunner</exec.mainClass>
  </properties>

  <dependencies>
    <!-- Canonical findings model (source of Severity/Finding/ValidationReport). Project module;
         its version comes from the reactor, never pinned here. -->
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- ebInterface namespace lookup and the lenient 6.1 reader used by the validation context.
         Project module; reactor-versioned. -->
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>formats-ebinterface</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- ReadResult, the outcome type the lenient reader above hands back. It arrives transitively
         through formats-ebinterface, but ValidationContext calls a method on it directly, so it is
         declared: this module depends on what it uses. Project module; reactor-versioned. -->
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>formats-api</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- phive: the XSD/Schematron validation engine by Philip Helger. phive-api is the executor
         model, phive-xml the XML source binding; both parent-managed (12.1.0), never redeclared.
         The AT-B2G Schematron stage runs on ph-schematron's pure (XPath) engine
         (com.helger.schematron:ph-schematron-pure) and reads SVRL via ph-schematron-api; both ride
         in transitively through the phive stack (phive-xml → ph-schematron-pure:10.0.0, phive-api →
         ph-schematron-api:10.0.0, verified via dependency:tree). We keep them transitive on purpose,
         mirroring how the XSD stage already consumes ph-diagnostics through phive rather than
         redeclaring every helger sub-artifact — phive is the single governed entry point for its
         own stack. -->
    <dependency>
      <groupId>com.helger.phive</groupId>
      <artifactId>phive-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.phive</groupId>
      <artifactId>phive-xml</artifactId>
    </dependency>
    <!-- The bundled ebInterface validation executor sets (VES), including the 6.1 XSD stage.
         Parent-managed (phive-rules 4.4.1), never redeclared. -->
    <dependency>
      <groupId>com.helger.phive.rules</groupId>
      <artifactId>phive-rules-ebinterface</artifactId>
    </dependency>
    <!-- The official OpenPeppol validation artefacts (M4): EN 16931 + Peppol BIS Billing 3.0
         Schematron, packaged as phive VES and consumed UNMODIFIED — the promise SPEC §7 made when
         M2 had to write its own ebInterface Schematron because AUSTRIAPRO publishes none. Which
         rule-set version is used is pinned in code (PeppolUblValidator), not left to whatever the
         library defaults to. Parent-managed (phive-rules 4.4.1), never redeclared. -->
    <dependency>
      <groupId>com.helger.phive.rules</groupId>
      <artifactId>phive-rules-peppol</artifactId>
    </dependency>
    <!-- UBL 2.1 JAXB types + the marshallers the Peppol VES needs on the classpath to register its
         executor sets. Parent-managed (ph-ubl 10.2.0), never redeclared. -->
    <dependency>
      <groupId>com.helger.ubl</groupId>
      <artifactId>ph-ubl21</artifactId>
    </dependency>
    <!-- UBL namespace lookup and the lenient readers used by the validation context, mirroring the
         formats-ebinterface dependency above. Project module; reactor-versioned. -->
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>formats-ubl</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- ebInterface 6.1 JAXB types (Ebi61InvoiceType) reached by the validation context's lenient
         reader. Parent-managed (8.1.0), never redeclared. -->
    <dependency>
      <groupId>com.helger</groupId>
      <artifactId>ph-ebinterface</artifactId>
    </dependency>

    <!-- TEST SCOPE ONLY: the JSON reader and canonical→ebInterface 6.1 mapper drive the milestone's
         end-to-end acceptance test (JSON → canonical → ebInterface 6.1 XML → this validator). Main
         code must never depend on mapping — validation checks a document against its own format and
         profile, and canonical mapping depends on validation, never the reverse (SPEC §2). The
         ValidationArchitectureTest imports main classes only (DoNotIncludeTests), so this test-scope
         edge is allowed by design, not a weakened rule. -->
    <dependency>
      <groupId>com.stoicera.einvoice</groupId>
      <artifactId>mapping</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.85</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <!-- Opts back in to the reactor-wide default (see the root POM's exec.skip property
               comment): this is the one module where `exec:java` is meant to actually run. The
               mainClass comes from this module's own exec.mainClass property (finding A9). -->
          <skip>false</skip>
          <mainClass>${exec.mainClass}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Mutation testing gives the coverage number teeth; run locally with
         ./mvnw -pl validation -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage
         Deliberately NOT "-am": the bare pitest goal runs against every project the reactor
         selects, so "-am" would drag core (its own profile) and formats-ebinterface into the
         same reactor. All four gated modules now carry the profile, so the CI job (ci.yml) can
         list them together, but it still installs the dependency closure first and runs the goal
         without "-am" — see mapping/pom.xml's reactor-landmine note. This module's PIT reactor
         also needs mapping (a test-scope dependency) in the local repo; the CI install step and a
         prior local reactor build both put it there.
         Kept out of the default verify because PIT re-runs the whole validation suite (XSD +
         Schematron + business-rule stages, secure-parse) once per mutant, far slower than a plain
         verify. -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>com.stoicera.einvoice.validation.*</param>
              </targetClasses>
              <!-- Measured mutation score 103/116 (89%) on 2026-07-24; a full run takes ~30 s. The
                   13 surviving mutants are documented and left on purpose. Six live in SecureXml, in
                   three DISTINCT categories (not one blanket "dominated by disallow-doctype-decl"
                   claim, which was previously and wrongly asserted for all six):
                   (a) FOUR are behaviourally dominated by the killed disallow-doctype-decl guard —
                   external-general-entities, external-parameter-entities, load-external-dtd and
                   expandEntityReferences each flip a feature whose non-default value only matters for
                   entities or an external DTD, and both can appear only inside a DOCTYPE that is
                   rejected first; no untrusted payload reaches entity resolution to distinguish them.
                   (b) setXIncludeAware(false) is NOT dominated: XInclude is an independent
                   document-body vector, and a DOCTYPE-free xi:include still discloses a local file
                   the moment awareness is on (proven by
                   SecureXmlTest.doesNotResolveXIncludeLocalFileDisclosure). Its RemoveVoidMethodCall
                   mutant nonetheless survives as an EQUIVALENT mutant — removing the setter falls
                   back to JAXP's already-false default, so no test can distinguish it — but the new
                   regression test now pins the behaviour, so an accidental flip to true or a changed
                   parser/JAXP default is caught even though PIT cannot mark the equivalent mutant
                   killed. (c) FEATURE_SECURE_PROCESSING is a defensive DoS-limit guard: its
                   entity-expansion caps are DOCTYPE-gated, but its attribute-count/element-depth caps
                   are DOCTYPE-independent, so it is not purely dominated — it survives only because no
                   corpus fixture reaches any DoS limit.
                   The remaining seven are equivalent or defensive-unreachable (early empty-list
                   returns in BusinessRuleStage, the always-true Schematron self-check, the never-hit
                   German/English count-mismatch fallback, and the System.exit/IO-catch seams in the
                   CLI). Gate set to 85 — a few points under the measured rate, mirroring mapping's
                   PIT wiring — so a genuine regression trips it without the benign survivors being a
                   tripwire. The validation module runs no jqwik property tests, so this score is
                   deterministic run to run. -->
              <mutationThreshold>85</mutationThreshold>
              <timestampedReports>false</timestampedReports>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
